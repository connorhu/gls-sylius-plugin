{# A kijelölt sorok (GlsParcel-ek) azonosítóit a Sylius admin generikus
   tömeges mechanizmusa csatolja `ids[]`-ként a `data-bulk-delete="index"`
   formhoz (a `bulk-delete.js`; a csoportnév a Sylius táblázat-helperéé). #}
<form method="post" action="{{ path('codeconjure_gls_admin_parcel_bulk_label') }}" data-bulk-delete="index">
